# Copy to .env at the repo root (gitignored) or use as the systemd EnvironmentFile on the VPS.
# Variables already set in the environment take precedence over .env.

# API-Football (all Bundesliga/International/Player Profiles collectors)
API_FOOTBALL_KEY=
# OpenWeather: geocoding (City Coordinates.py), pro hourly forecast
# (future_weather_hourly_78.py), current weather (historic_weather_data_78.py)
OPENWEATHER_GEO_KEY=
OPENWEATHER_FORECAST_KEY=
OPENWEATHER_CURRENT_KEY=

# Optional: repo root if the code is not run from its own checkout (default: derived from each file's location)
# KI_PROJECT_ROOT=/srv/ki-projekt
# Optional: Python used by the Shiny dashboard to rerun build_dashboard_data.py
# ORAKEL_PYTHON=/srv/ki-projekt/.venv/bin/python
